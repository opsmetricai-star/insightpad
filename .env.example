# ---- Supabase (https://supabase.com/dashboard -> Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser. Used for admin payment approval and lead capture.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI (server only) ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Payments (checkout links supplied by the owner; defaults are in src/content/site.ts) ----
NEXT_PUBLIC_PAY_LINK_PROFESSIONAL=
NEXT_PUBLIC_PAY_LINK_TEAM=
NEXT_PUBLIC_PAY_LINK_ENTERPRISE=

# ---- Admin ----
# Comma-separated emails allowed to review payment claims at /app/admin
ADMIN_EMAILS=you@example.com
